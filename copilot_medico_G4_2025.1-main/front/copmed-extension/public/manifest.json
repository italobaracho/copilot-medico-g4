{
    "manifest_version": 3,
    "version": "1.0.0",
    "name": "Copmed Extension",
    "action": {
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "scripting",
        "activeTab",
        "storage"
   
    ],
    "host_permissions": [ 
        "https://copilot-medico-g4-production.up.railway.app/*" 
    
    ],
    "icons": {
        "32": "copilot-icon.png",
        "48": "CopMed_LogoBig.png",
        "128": "CopMed_LogoBig.png"
    },
    "content_scripts": [
        {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "all_frames": true
        }
    ]
}